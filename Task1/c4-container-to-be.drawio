        <mxCell id="c25" value='&lt;b style="font-size:13px"&gt;Сервис клиента (MDM)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;единый client_id, согласия&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1610" y="320" width="220" height="110" as="geometry"/></mxCell>
