        <mxCell id="d34" value='&lt;b style="font-size:13px"&gt;БД учёта&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Managed PostgreSQL]&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2750" y="460" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c35" value='&lt;b style="font-size:13px"&gt;Шина событий&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Managed Apache Kafka, Schema Registry]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;заменяет ESB; контракты событий: payment.completed, loan.issued, client_id и согласия, события доменов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=#263238;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="2980" height="72" as="geometry"/></mxCell>
