        <mxCell id="c27" value='&lt;b style="font-size:13px"&gt;HR-система&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[существующая]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;сотрудники, графики, ФОТ&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1990" y="320" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c28" value='&lt;b style="font-size:13px"&gt;Система учёта ТМЦ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[существующая]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;склад, оборудование, закупки&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1990" y="560" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c29" value='&lt;b style="font-size:13px"&gt;Сервисы партнёрского домена&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[по шаблону]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Terraform + Kafka topics + регистрация в DataHub&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2370" y="320" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="d30" value='&lt;b style="font-size:13px"&gt;БД домена&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Managed PostgreSQL]&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2370" y="460" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c31" value='&lt;b style="font-size:13px"&gt;Шина событий&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Managed Apache Kafka, Schema Registry]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;заменяет ESB; контракты событий: payment.completed, loan.issued, client_id и согласия, события доменов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=#263238;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="2600" height="72" as="geometry"/></mxCell>
        <mxCell id="b32" value="&lt;b&gt;Платформа данных (Lakehouse)&lt;/b&gt; &lt;span style='font-size:11px'&gt;— команда Data Platform, self-serve&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#00695C;strokeWidth=2;fontColor=#00695C;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1790" height="410" as="geometry"/></mxCell>
        <mxCell id="c33" value='&lt;b style="font-size:13px"&gt;Yandex Data Transfer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[CDC]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;из БД доменов и SQL Server&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#004D40;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="990" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="d34" value='&lt;b style="font-size:13px"&gt;Озеро данных&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Object Storage + Apache Iceberg]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;бакеты по доменам; bronze / silver / gold&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#004D40;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="440" y="990" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="c35" value='&lt;b style="font-size:13px"&gt;Dremio&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[SQL-движок]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;семантический слой, reflections, row-level security&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#004D40;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="990" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="c36" value='&lt;b style="font-size:13px"&gt;Портал самообслуживания (витрина данных)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Dremio UI + Yandex DataLens]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;конструктор отчётов; без медданных&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#004D40;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="990" width="260" height="120" as="geometry"/></mxCell>
