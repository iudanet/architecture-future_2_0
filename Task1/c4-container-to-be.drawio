        <mxCell id="c37" value='&lt;b style="font-size:13px"&gt;Yandex Data Transfer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[CDC]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;из БД доменов и SQL Server&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00796B;strokeColor=#004D40;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="990" width="260" height="120" as="geometry"/></mxCell>
