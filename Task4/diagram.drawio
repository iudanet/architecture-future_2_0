  <diagram id="Развёртывание" name="Развёртывание">
    <mxGraphModel dx="2300" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1380" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;«Будущее 2.0» — автоматизация развёртывания типовой среды домена (Yandex Cloud, Terraform)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="2200" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value='&lt;b style="font-size:13px"&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[рабочее место / CI]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;провайдер yandex-cloud/yandex ~&gt; 0.140&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;fontColor=#263238;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b style="font-size:13px"&gt;Профиль yc, OAuth-токен / ключ сервисного аккаунта&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[вручную]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;YC_TOKEN, YC_CLOUD_ID, YC_FOLDER_ID&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontColor=#3E2723;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b style="font-size:13px"&gt;SSH-ключ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[вручную]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;~/.ssh/id_ed25519.pub&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontColor=#3E2723;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b style="font-size:13px"&gt;Платёжный аккаунт&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[вручную]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontColor=#3E2723;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b style="font-size:13px"&gt;Сеть администратора&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[admin_cidrs]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;конкретные адреса /32: рабочее место / VPN&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;fontColor=#263238;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;Облако Yandex Cloud&lt;/b&gt; — вручную" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFBF5;strokeColor=#E65100;strokeWidth=2;fontColor=#E65100;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="460" y="64" width="1800" height="1240" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b style="font-size:13px"&gt;Квоты облака&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[вручную]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontColor=#3E2723;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1960" y="80" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;Каталог (folder)&lt;/b&gt; — вручную; Terraform управляет только ресурсами future20-*, чужие не трогает" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFBF5;strokeColor=#E65100;strokeWidth=2;fontColor=#E65100;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="1720" height="1110" as="geometry"/></mxCell>
